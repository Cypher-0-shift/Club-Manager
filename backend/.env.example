# ═══════════════════════════════════════════════════════════
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ─────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ─────────────────────────────────────────────
# Security (PHASE 3)
# ─────────────────────────────────────────────
# Generate using: python scripts/generate_keys.py
JWT_SECRET=your-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-bytes-base64

# ─────────────────────────────────────────────
# CORS Configuration (PHASE 3)
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production (Vercel):
# FRONTEND_ORIGIN=https://club-manager-xi-six.vercel.app
# ALLOWED_ORIGINS=https://club-manager-xi-six.vercel.app,https://*.vercel.app

# ─────────────────────────────────────────────
# Redis Configuration (PHASE 2)
# ─────────────────────────────────────────────
# Optional - caching disabled if not provided
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Production example (Render Redis):
# REDIS_HOST=red-xxxxx.oregon-postgres.render.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ─────────────────────────────────────────────
# Secrets Manager (PHASE 3)
# ─────────────────────────────────────────────
# Choose one: Environment variables, AWS Secrets Manager, or Supabase Vault

# Option 1: Environment variables (development)
USE_ENV_SECRETS=true

# Option 2: AWS Secrets Manager (production)
AWS_SECRETS_ENABLED=false
AWS_SECRET_NAME=club-task-manager/secrets
AWS_REGION=us-east-1

# Option 3: Supabase Vault (production)
SUPABASE_VAULT_ENABLED=false

# Option 4: File-based secrets (Kubernetes)
# SECRETS_FILE_PATH=/etc/secrets/secrets.json

# ─────────────────────────────────────────────
# Encryption (PHASE 3)
# ─────────────────────────────────────────────
# Enable application-level encryption for sensitive fields
ENABLE_ENCRYPTION=false

# ─────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────
API_VERSION=v1

# ─────────────────────────────────────────────
# Production Settings (PHASE 5)
# ─────────────────────────────────────────────
# Number of Uvicorn workers (recommended: 2-4 for 100 users)
# WORKERS=4

# Log level (debug, info, warning, error)
# LOG_LEVEL=info
