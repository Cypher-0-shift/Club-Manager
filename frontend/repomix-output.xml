        <p style={{ marginTop: '20px', textAlign: 'center', fontSize: '13px', color: 'var(--color-text-muted)' }}>
          New member?{' '}
          <a href="/signup" style={{ color: '#a3a3a3', fontWeight: 500 }}>
            Sign Up
          </a>
        </p>
      </motion.div>
    </div>
  );
}
